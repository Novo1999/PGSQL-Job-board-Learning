{
  "name": "job-board",
  "version": "1.0.0",
  "description": "A Job Board backend built to learn SQL and PostgreSQL deeply. Node.js + Express + node-postgres, no ORM.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit && tsc -p scripts/tsconfig.json",
    "postman": "tsx scripts/generate-postman.ts",
    "postman:check": "tsx scripts/generate-postman.ts --check",
    "db:schema": "tsx scripts/db.ts schema",
    "db:seed": "tsx scripts/db.ts seed",
    "db:reset": "tsx scripts/db.ts schema seed"
  },
  "keywords": [
    "postgresql",
    "sql",
    "express",
    "node-postgres",
    "job-board",
    "learning",
    "sql-exercises"
  ],
  "author": "Novo1999",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Novo1999/PGSQL-Job-board-Learning.git"
  },
  "bugs": {
    "url": "https://github.com/Novo1999/PGSQL-Job-board-Learning/issues"
  },
  "homepage": "https://github.com/Novo1999/PGSQL-Job-board-Learning#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "morgan": "^1.11.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
