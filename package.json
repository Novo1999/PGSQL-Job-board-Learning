{
  "name": "job-board",
  "version": "1.0.0",
  "description": "A Job Board backend built to learn SQL and PostgreSQL deeply. Node.js + Express + node-postgres, no ORM.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts"
  },
  "keywords": [
